# Copy to `.env` and fill in from your Supabase project
# (Dashboard → Project Settings → API). `.env` is gitignored.
#
# These are exposed to the browser by design: the anon key is public and
# access is enforced server-side by Row-Level Security.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side (serverless functions in api/). NOT prefixed with VITE_, so they
# are never shipped to the browser. Same values as the two above — the AI Haul
# endpoint uses them to verify the caller's Supabase session + rate-limit.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic API key for the AI endpoints (api/workout.js, api/haul.js).
ANTHROPIC_API_KEY=sk-ant-...
